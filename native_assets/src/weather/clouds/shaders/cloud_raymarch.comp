#version 460
// ==============================================================================
// Vulkan 1.3 Compute Shader: Volumetric Cloud Raymarcher
// Converted from Robert Beckebans's OpenGL-VolumetricClouds Nubis-Decima engine
// ==============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D u_CloudOutput;
layout(set = 0, binding = 1) uniform sampler3D u_PerlinWorleyNoise;
layout(set = 0, binding = 2) uniform sampler3D u_WorleyDetailNoise;
layout(set = 0, binding = 3) uniform sampler2D u_WeatherMap;
layout(set = 0, binding = 4) uniform sampler2D u_SceneDepth;

layout(push_constant) uniform CloudPushConstants {
    mat4 invViewProj;
    vec4 cameraPosition;      // xyz: pos, w: fov
    vec4 sunDirection;        // xyz: dir, w: time
    vec4 sunColor;            // rgb: color, w: intensity
    vec4 cloudParams;         // x: coverage, y: density, z: cloudType (0=stratus, 1=stratocumulus, 2=cumulus), w: windSpeed
    vec4 scatteringParams;    // x: forwardG (0.8), y: backwardG (-0.2), z: powderFactor, w: sunAbsorption
} pc;

#define EARTH_RADIUS 700000.0
#define SPHERE_INNER_RADIUS (EARTH_RADIUS + 5000.0)
#define SPHERE_OUTER_RADIUS (SPHERE_INNER_RADIUS + 17000.0)

#define STRATUS_GRADIENT vec4(0.0, 0.1, 0.2, 0.3)
#define STRATOCUMULUS_GRADIENT vec4(0.02, 0.2, 0.48, 0.625)
#define CUMULUS_GRADIENT vec4(0.00, 0.1625, 0.88, 0.98)

#define AMBIENT_TOP vec3(0.66, 0.58, 0.58)
#define AMBIENT_BOTTOM vec3(0.25, 0.27, 0.31)

const vec3 NOISE_KERNEL[6] = vec3[6](
    vec3( 0.38051305,  0.92453449, -0.02111345),
    vec3(-0.50625799, -0.03590792, -0.86163418),
    vec3(-0.32509218, -0.94557439,  0.01428793),
    vec3( 0.09026238, -0.27376545,  0.95755165),
    vec3( 0.28128598,  0.42443639, -0.86065785),
    vec3(-0.16852403,  0.14748697,  0.97460106)
);

float Remap(float originalValue, float originalMin, float originalMax, float newMin, float newMax) {
    return newMin + (((originalValue - originalMin) / (originalMax - originalMin)) * (newMax - newMin));
}

float GetHeightFraction(vec3 pos) {
    float alt = pos.y;
    return clamp((alt - (SPHERE_INNER_RADIUS - EARTH_RADIUS)) / (SPHERE_OUTER_RADIUS - SPHERE_INNER_RADIUS), 0.0, 1.0);
}

float GetDensityForCloud(float heightFraction, float cloudType) {
    float stratusFactor = 1.0 - clamp(cloudType * 2.0, 0.0, 1.0);
    float stratoCumulusFactor = 1.0 - abs(cloudType - 0.5) * 2.0;
    float cumulusFactor = clamp(cloudType - 0.5, 0.0, 1.0) * 2.0;

    vec4 grad = stratusFactor * STRATUS_GRADIENT + stratoCumulusFactor * STRATOCUMULUS_GRADIENT + cumulusFactor * CUMULUS_GRADIENT;
    return smoothstep(grad.x, grad.y, heightFraction) * (1.0 - smoothstep(grad.z, grad.w, heightFraction));
}

float Beer(float d) {
    return exp(-d);
}

float Powder(float d) {
    return 1.0 - exp(-2.0 * d);
}

float HenyeyGreenstein(float cosTheta, float g) {
    float gg = g * g;
    return (1.0 - gg) / (4.0 * 3.14159265 * pow(max(0.0001, 1.0 + gg - 2.0 * g * cosTheta), 1.5));
}

float SampleCloudDensity(vec3 p, float time, bool expensive) {
    float hFrac = GetHeightFraction(p);
    if (hFrac <= 0.0 || hFrac >= 1.0) return 0.0;

    vec3 windDir = normalize(vec3(0.5, 0.0, 0.1));
    float shear = hFrac * 750.0;
    float speed = pc.cloudParams.w * 8.0;
    vec3 animPos = p + windDir * (shear + time * speed);

    vec2 uv = animPos.xz * 0.00003;
    vec4 lowFreq = texture(u_PerlinWorleyNoise, vec3(uv * 40.0, hFrac));
    float lowFreqFBM = dot(lowFreq.gba, vec3(0.625, 0.25, 0.125));
    float baseCloud = Remap(lowFreq.r, -(1.0 - lowFreqFBM), 1.0, 0.0, 1.0);

    float heightDensity = GetDensityForCloud(hFrac, pc.cloudParams.z);
    baseCloud *= heightDensity;

    float coverage = pc.cloudParams.x;
    float baseCloudWithCoverage = Remap(baseCloud, 1.0 - coverage, 1.0, 0.0, 1.0);
    baseCloudWithCoverage = clamp(baseCloudWithCoverage * coverage, 0.0, 1.0);

    if (expensive && baseCloudWithCoverage > 0.01) {
        vec3 erodeNoise = texture(u_WorleyDetailNoise, vec3(uv * 120.0, hFrac * 3.0)).rgb;
        float highFreqFBM = dot(erodeNoise, vec3(0.625, 0.25, 0.125));
        float modifier = mix(highFreqFBM, 1.0 - highFreqFBM, clamp(hFrac * 8.0, 0.0, 1.0));
        baseCloudWithCoverage = baseCloudWithCoverage - modifier * 0.45 * (1.0 - baseCloudWithCoverage);
    }

    return clamp(baseCloudWithCoverage * pc.cloudParams.y, 0.0, 1.0);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = imageSize(u_CloudOutput);
    if (pixelCoord.x >= screenSize.x || pixelCoord.y >= screenSize.y) return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(screenSize);
    vec4 ndc = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec4 worldTarget = pc.invViewProj * ndc;
    vec3 rayDir = normalize(worldTarget.xyz / worldTarget.w - pc.cameraPosition.xyz);

    if (rayDir.y <= 0.005) {
        imageStore(u_CloudOutput, pixelCoord, vec4(0.0));
        return;
    }

    float tInner = (5000.0 - pc.cameraPosition.y) / rayDir.y;
    float tOuter = (22000.0 - pc.cameraPosition.y) / rayDir.y;
    float tNear = max(0.0, tInner);
    float tFar = max(tNear, tOuter);

    int steps = 64;
    float stepSize = (tFar - tNear) / float(steps);

    float cosTheta = dot(rayDir, pc.sunDirection.xyz);
    float phaseSun = mix(
        HenyeyGreenstein(cosTheta, pc.scatteringParams.x),
        HenyeyGreenstein(cosTheta, pc.scatteringParams.y),
        0.3
    );

    float transmittance = 1.0;
    vec3 accumulatedRadiance = vec3(0.0);
    float t = tNear;

    for (int i = 0; i < steps; ++i) {
        if (transmittance < 0.01) break;

        vec3 samplePos = pc.cameraPosition.xyz + rayDir * t;
        float density = SampleCloudDensity(samplePos, pc.sunDirection.w, true);

        if (density > 0.001) {
            float stepDepth = density * stepSize * 0.005;
            float beerAtten = Beer(stepDepth);
            float powderAtten = Powder(stepDepth);
            float energy = beerAtten * mix(1.0, powderAtten, pc.scatteringParams.z);

            // Light ray cone march
            float lightDensity = 0.0;
            float ds = stepSize * 3.0;
            for (int j = 0; j < 6; ++j) {
                vec3 conePos = samplePos + (pc.sunDirection.xyz + NOISE_KERNEL[j] * 0.15) * ds * float(j + 1) * 0.5;
                lightDensity += SampleCloudDensity(conePos, pc.sunDirection.w, false) * ds;
            }

            float sunEnergy = Beer(lightDensity * pc.scatteringParams.w * 0.005);
            float hFrac = GetHeightFraction(samplePos);
            vec3 ambient = mix(AMBIENT_BOTTOM, AMBIENT_TOP, hFrac);
            vec3 direct = pc.sunColor.rgb * sunEnergy * phaseSun;

            vec3 stepRadiance = (ambient + direct) * density;
            accumulatedRadiance += stepRadiance * transmittance;
            transmittance *= energy;
        }

        t += stepSize;
    }

    imageStore(u_CloudOutput, pixelCoord, vec4(accumulatedRadiance, 1.0 - transmittance));
}
