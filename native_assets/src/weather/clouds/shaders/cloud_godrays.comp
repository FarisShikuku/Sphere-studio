#version 460
// ==============================================================================
// Vulkan 1.3 Compute Shader: Crepuscular Volumetric God Rays
// Converted from AmanSachan1/Meteoros (Aman Sachan & Meghana Seshadri, CIS 565 UPenn)
// ==============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D u_CloudColor;
layout(set = 0, binding = 1, r16f) uniform readonly image2D u_OcclusionMap;
layout(set = 0, binding = 2, rgba16f) uniform image2D u_CompositeOutput;

layout(push_constant) uniform GodRaysPushConstants {
    vec2 sunScreenPos;       // Normalized screen space sun coordinate [0..1]
    float intensity;         // Ray intensity multiplier (e.g. 0.65)
    float decay;             // Exponential decay factor along ray (e.g. 0.96)
    float density;           // Sampling density step size (e.g. 0.85)
    float weight;            // Per-sample accumulation weight (e.g. 0.58)
    int samples;             // March iterations (default 32)
    float exposure;          // ACES tonemapping exposure scale (e.g. 1.2)
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = imageSize(u_CompositeOutput);
    if (pixelCoord.x >= screenSize.x || pixelCoord.y >= screenSize.y) return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(screenSize);
    vec4 baseColor = imageLoad(u_CloudColor, pixelCoord);

    // Vector from current pixel towards sun screen position
    vec2 deltaTexCoord = (uv - pc.sunScreenPos);
    deltaTexCoord *= 1.0 / float(pc.samples) * pc.density;

    vec2 marchCoord = uv;
    float illuminationDecay = 1.0;
    vec3 godRayColor = vec3(0.0);

    for (int i = 0; i < pc.samples; ++i) {
        marchCoord -= deltaTexCoord;
        ivec2 samplePixel = ivec2(marchCoord * vec2(screenSize));
        samplePixel = clamp(samplePixel, ivec2(0), screenSize - ivec2(1));

        float sampleOcclusion = imageLoad(u_OcclusionMap, samplePixel).r;
        sampleOcclusion *= illuminationDecay * pc.weight;
        godRayColor += vec3(sampleOcclusion);

        illuminationDecay *= pc.decay;
    }

    vec3 sunTint = vec3(1.0, 0.94, 0.82) * pc.intensity;
    vec3 composite = baseColor.rgb + godRayColor * sunTint;

    // ACES Film Tone Mapping
    vec3 x = max(vec3(0.0), composite * pc.exposure);
    vec3 toneMapped = (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14);

    imageStore(u_CompositeOutput, pixelCoord, vec4(toneMapped, baseColor.a));
}
