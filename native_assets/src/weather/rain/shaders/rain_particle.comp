#version 460
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) buffer RainBuffer {
    vec4 positions[]; // xyz: pos, w: life
} rain;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= rain.positions.length()) return;

    rain.positions[id].y -= 0.25; // fall
    if (rain.positions[id].y < 0.0) {
        rain.positions[id].y = 25.0; // reset
    }
}
