#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uFloorplanGrid;

layout(push_constant) uniform FloorplanPushConstants {
    uint uRoomType;
    float uWidthMeters;
    float uDepthMeters;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uFloorplanGrid);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    float tile = fract(uv.x * 8.0) * fract(uv.y * 8.0);
    vec3 col = (pc.uRoomType == 0u)
        ? mix(vec3(0.68, 0.50, 0.34), vec3(0.76, 0.58, 0.40), step(0.05, tile))
        : vec3(0.55 + 0.08 * step(0.05, tile));

    imageStore(uFloorplanGrid, coord, vec4(col, 1.0));
}
