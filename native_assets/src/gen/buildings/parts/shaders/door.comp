#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform DoorPushConstants {
    float uWidth;
    float uHeight;
    uint uDoorType;
} pc;

layout(std430, binding = 0) writeonly buffer DoorFrameBuffer {
    vec4 outBounds[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx > 0u) return;
    outBounds[0] = vec4(pc.uWidth, pc.uHeight, float(pc.uDoorType), 1.0);
}
