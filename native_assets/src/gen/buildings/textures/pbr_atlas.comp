#version 450
#include "../shaders/include/building_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uBuildingPbrAtlas;

layout(push_constant) uniform AtlasPushConstants {
    uint uTileGridSize;
    float uWeatheringStrength;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uBuildingPbrAtlas);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec2 tile = floor(uv * float(max(pc.uTileGridSize, 1u)));
    vec2 tileUV = fract(uv * float(max(pc.uTileGridSize, 1u)));

    uint tileIdx = uint(tile.y) * max(pc.uTileGridSize, 1u) + uint(tile.x);
    vec3 col = vec3(0.70, 0.72, 0.74);
    if (tileIdx == 0u) {
        // Board-formed architectural concrete
        col = vec3(0.66) + 0.05 * sin(tileUV.y * 64.0) * (1.0 - pc.uWeatheringStrength * 0.25);
    } else if (tileIdx == 1u) {
        // Red masonry brick
        col = computeProceduralBrickMortar(tileUV, 16.0, 8.0, vec3(0.56, 0.23, 0.18), vec3(0.75, 0.72, 0.68));
    } else if (tileIdx == 2u) {
        // Anodized dark mullion aluminum
        col = vec3(0.14, 0.16, 0.19);
    } else {
        // Refractive PBR architectural glass tile with tempered roller-wave & bevel seal
        float edgeMask = smoothstep(0.0, 0.08, min(min(tileUV.x, 1.0 - tileUV.x), min(tileUV.y, 1.0 - tileUV.y)));
        vec3 baseN = normalize(vec3(
            sin(tileUV.x * 12.56637) * 0.025,
            cos(tileUV.y * 12.56637) * 0.028,
            1.0
        ));
        vec3 viewV = normalize(vec3(0.32, 0.24, 0.91));
        vec3 sunL = normalize(vec3(0.45, 0.72, 0.52));
        float alpha = 1.0;
        col = evaluateRefractiveArchitecturalGlassPBR(
            0u,
            vec3(tileUV.x * 4.0, tileUV.y * 4.0, 0.0),
            baseN,
            viewV,
            sunL,
            tileUV,
            1.85,
            alpha
        ) * (0.72 + 0.28 * edgeMask);
    }

    imageStore(uBuildingPbrAtlas, coord, vec4(col, 1.0));
}
