#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uOctahedralAtlas;

layout(push_constant) uniform PushConstants {
    float uSliceAngle;
    float uAmbientOcclusion;
    uint uAtlasTileIndex;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOctahedralAtlas);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec4 normalDepth = vec4(0.0, 1.0, 0.0, 1.0);

    // Bake surface normals into octahedral projection
    vec2 oct = uv * 2.0 - 1.0;
    vec3 n = vec3(oct.x, 1.0 - abs(oct.x) - abs(oct.y), oct.y);
    if (n.y < 0.0) {
        vec2 signN = vec2(n.x >= 0.0 ? 1.0 : -1.0, n.z >= 0.0 ? 1.0 : -1.0);
        n.xz = (1.0 - abs(n.zx)) * signN;
    }
    n = normalize(n);

    normalDepth = vec4(n * 0.5 + 0.5, 1.0);
    imageStore(uOctahedralAtlas, coord, normalDepth);
}
