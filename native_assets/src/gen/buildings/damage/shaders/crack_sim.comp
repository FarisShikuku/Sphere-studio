#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, r8) uniform writeonly image2D uCrackTexture;

layout(push_constant) uniform PushConstants {
    vec2 uEpicenter;
    float uSeverity;
    float uBranchFactor;
    float uTime;
} pc;

float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float voronoi(vec2 p) {
    vec2 n = floor(p);
    vec2 f = fract(p);
    float md = 8.0;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            vec2 g = vec2(float(i), float(j));
            vec2 o = vec2(hash(n + g), hash(n + g + vec2(1.0, 0.0)));
            vec2 r = g + o - f;
            float d = dot(r, r);
            if (d < md) md = d;
        }
    }
    return sqrt(md);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uCrackTexture);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec2 delta = uv - pc.uEpicenter;
    float dist = length(delta);

    // Voronoi crack edges
    float v1 = voronoi(uv * 12.0 * pc.uBranchFactor);
    float v2 = voronoi(uv * 24.0 * pc.uBranchFactor + vec2(5.2, 1.3));

    float crackEdge = smoothstep(0.06, 0.0, abs(v1 - 0.25)) +
                      smoothstep(0.04, 0.0, abs(v2 - 0.20)) * 0.6;

    // Distance falloff from blast/damage origin
    float falloff = smoothstep(pc.uSeverity, 0.0, dist);
    float crackVal = clamp(crackEdge * falloff, 0.0, 1.0);

    imageStore(uCrackTexture, coord, vec4(crackVal, 0.0, 0.0, 1.0));
}
