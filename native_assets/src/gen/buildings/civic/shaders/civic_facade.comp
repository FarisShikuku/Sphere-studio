#version 450
#include "../../shaders/include/building_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uCivicFacadeTexture;

layout(push_constant) uniform CivicPushConstants {
    uint uBayColumns;
    float uPilasterWidth;
    uint uGlassType;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uCivicFacadeTexture);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    float bayF = fract(uv.x * float(max(pc.uBayColumns, 1u)));
    vec3 limestone = vec3(0.84, 0.81, 0.75) * (0.94 + 0.06 * buildingHash21(floor(uv * 16.0)));

    vec3 col = limestone;
    if (bayF > pc.uPilasterWidth && bayF < (1.0 - pc.uPilasterWidth) && uv.y > 0.15 && uv.y < 0.88) {
        col = computeArchitecturalGlassTint(pc.uGlassType, vec3(0.0, 0.2, 1.0), vec3(0.0, 0.0, 1.0));
    }

    imageStore(uCivicFacadeTexture, coord, vec4(col, 1.0));
}
