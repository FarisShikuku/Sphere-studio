#version 450
#include "../../shaders/include/building_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uWindowGridTexture;

layout(push_constant) uniform PushConstants {
    float uAspect;
    float uMullionThickness;
    uint uHorizBays;
    uint uVertFloors;
    float uWindowIor;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uWindowGridTexture);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec4 col = vec4(0.18, 0.20, 0.24, 1.0); // Anodized aluminum frame

    float bayFrac = fract(uv.x * float(max(pc.uHorizBays, 1u)));
    float floorFrac = fract(uv.y * float(max(pc.uVertFloors, 1u)));

    float t = pc.uMullionThickness;
    if (bayFrac > t && bayFrac < (1.0 - t) && floorFrac > t && floorFrac < (1.0 - t)) {
        float alpha = 1.0;
        float ior = (pc.uWindowIor > 0.5) ? pc.uWindowIor : 1.85;
        vec3 glassRgb = evaluateRefractiveArchitecturalGlassPBR(
            0u,
            vec3(uv.x * 12.0, uv.y * 10.0, 0.0),
            vec3(0.0, 0.0, 1.0),
            normalize(vec3(0.30, 0.20, 0.93)),
            normalize(vec3(0.45, 0.72, 0.52)),
            vec2(bayFrac, floorFrac),
            ior,
            alpha
        );
        col = vec4(glassRgb, alpha);
    }

    imageStore(uWindowGridTexture, coord, col);
}
