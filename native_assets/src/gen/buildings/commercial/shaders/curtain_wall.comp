#version 450
#include "../../shaders/include/building_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uCurtainWallTexture;

layout(push_constant) uniform CurtainWallPushConstants {
    uint uBayCount;
    uint uFloorCount;
    uint uGlassType;
    float uSpandrelHeight;
    float uWindowIor;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uCurtainWallTexture);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    float bayF = fract(uv.x * float(max(pc.uBayCount, 1u)));
    float floorF = fract(uv.y * float(max(pc.uFloorCount, 1u)));

    vec3 col = vec3(0.14, 0.16, 0.20); // Anodized aluminum mullion
    float alpha = 1.0;
    float ior = (pc.uWindowIor > 0.5) ? pc.uWindowIor : 1.85;
    if (floorF < pc.uSpandrelHeight) {
        col = vec3(0.08, 0.12, 0.18); // Opaque spandrel shadow-box glass band
    } else if (bayF > 0.04 && bayF < 0.96 && floorF < 0.96) {
        col = evaluateRefractiveArchitecturalGlassPBR(
            pc.uGlassType,
            vec3(uv.x * 16.0, uv.y * 12.0, 0.0),
            vec3(0.0, 0.0, 1.0),
            normalize(vec3(0.28, 0.22, 0.93)),
            normalize(vec3(0.45, 0.72, 0.52)),
            vec2(bayF, floorF),
            ior,
            alpha
        );
    }

    imageStore(uCurtainWallTexture, coord, vec4(col, alpha));
}
