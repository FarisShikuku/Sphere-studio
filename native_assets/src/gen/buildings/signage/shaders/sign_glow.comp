#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uNeonGlowTexture;

layout(push_constant) uniform PushConstants {
    vec4 uGlowColor;
    float uPulsingFrequency;
    float uTubeRadius;
    float uBloomSpread;
    float uTime;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uNeonGlowTexture);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec2 centered = (uv - 0.5) * 2.0;

    // Pulse intensity
    float pulse = 0.85 + 0.15 * sin(pc.uTime * pc.uPulsingFrequency * 6.28318);

    // Rounded rectangle distance for neon border
    vec2 d = abs(centered) - vec2(0.7, 0.4);
    float dist = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
    dist = abs(dist);

    float core = smoothstep(pc.uTubeRadius, 0.0, dist);
    float bloom = exp(-dist * pc.uBloomSpread) * pulse;

    vec4 color = mix(pc.uGlowColor * bloom, vec4(1.0, 1.0, 1.0, 1.0), core * 0.9);
    imageStore(uNeonGlowTexture, coord, color);
}
