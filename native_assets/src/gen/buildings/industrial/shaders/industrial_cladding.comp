#version 450
#include "../../shaders/include/building_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uIndustrialCladding;

layout(push_constant) uniform IndustrialCladdingPush {
    float uRibFrequency;
    float uRustFactor;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uIndustrialCladding);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    float rib = 0.5 + 0.5 * sin(uv.x * pc.uRibFrequency * 6.2831853);
    vec3 steel = vec3(0.42 + 0.18 * rib, 0.44 + 0.18 * rib, 0.47 + 0.18 * rib);
    float grime = smoothstep(0.35, 0.0, uv.y) * pc.uRustFactor;
    vec3 col = mix(steel, vec3(0.36, 0.20, 0.12), grime);

    imageStore(uIndustrialCladding, coord, vec4(col, 1.0));
}
