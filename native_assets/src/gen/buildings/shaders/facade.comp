#version 450
#include "include/building_common.glsl"
#include "include/building_types.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uFacadeAtlas;

layout(push_constant) uniform FacadePushConstants {
    uint uWallMaterial;
    uint uGlassType;
    uint uFloorCount;
    uint uWindowsPerFacade;
    float uFloorHeight;
    float uWindowRatio;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uFacadeAtlas);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec3 col = vec3(0.72, 0.74, 0.76);

    if (pc.uWallMaterial == BLD_WALL_BRICK_RED_MASONRY) {
        col = computeProceduralBrickMortar(uv, 24.0, 12.0, vec3(0.56, 0.23, 0.18), vec3(0.76, 0.73, 0.68));
    } else if (pc.uWallMaterial == BLD_WALL_WEATHERED_CORTEN_STEEL) {
        float rust = buildingHash21(floor(uv * 32.0));
        col = mix(vec3(0.42, 0.19, 0.10), vec3(0.58, 0.28, 0.12), rust);
    } else if (pc.uWallMaterial == BLD_WALL_DARK_BASALT_SLATE) {
        col = vec3(0.14, 0.16, 0.19);
    }

    float floorFrac = fract(uv.y * float(max(pc.uFloorCount, 1u)));
    float bayFrac = fract(uv.x * float(max(pc.uWindowsPerFacade, 1u)));
    float margin = 0.5 * (1.0 - clamp(pc.uWindowRatio, 0.2, 0.9));

    if (floorFrac > 0.22 && floorFrac < 0.88 && bayFrac > margin && bayFrac < (1.0 - margin)) {
        col = computeArchitecturalGlassTint(pc.uGlassType, vec3(0.0, 0.2, 1.0), vec3(0.0, 0.0, 1.0));
    }

    imageStore(uFacadeAtlas, coord, vec4(col, 1.0));
}
