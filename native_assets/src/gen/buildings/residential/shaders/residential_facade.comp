#version 450
#include "../../shaders/include/building_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uResidentialFacade;

layout(push_constant) uniform ResidentialPushConstants {
    uint uStyle;       // 0=brick, 1=stucco, 2=timber/louver, 3=basalt
    uint uFloorCount;
    float uWindowRatio;
    float uShuttersEnabled;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uResidentialFacade);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec3 col = vec3(0.86, 0.84, 0.80);
    if (pc.uStyle == 0u) {
        col = computeProceduralBrickMortar(uv, 20.0, 10.0, vec3(0.58, 0.24, 0.19), vec3(0.76, 0.74, 0.70));
    } else if (pc.uStyle == 2u) {
        float grain = 0.9 + 0.1 * sin(uv.y * 90.0);
        col = vec3(0.55, 0.36, 0.21) * grain;
    } else if (pc.uStyle == 3u) {
        col = vec3(0.16, 0.18, 0.21);
    }

    float floorF = fract(uv.y * float(max(pc.uFloorCount, 1u)));
    float bayF = fract(uv.x * 4.0);
    float margin = 0.5 * (1.0 - clamp(pc.uWindowRatio, 0.25, 0.8));
    if (floorF > 0.25 && floorF < 0.82 && bayF > margin && bayF < (1.0 - margin)) {
        col = computeArchitecturalGlassTint(0u, vec3(0.0, 0.15, 1.0), vec3(0.0, 0.0, 1.0));
    }

    imageStore(uResidentialFacade, coord, vec4(col, 1.0));
}
