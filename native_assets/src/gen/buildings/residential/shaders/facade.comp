#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uFacadeTexture;

layout(push_constant) uniform PushConstants {
    uint uStyle;
    float uStoryHeight;
    float uWindowRatio;
    uint uFloorCount;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uFacadeTexture);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec4 baseColor = vec4(0.85, 0.83, 0.80, 1.0); // Concrete/brick

    // Procedural mortar & window grid pattern
    float floorFrac = fract(uv.y * float(pc.uFloorCount));
    float horizFrac = fract(uv.x * 6.0);

    if (floorFrac > 0.25 && floorFrac < 0.85 && horizFrac > 0.2 && horizFrac < 0.8) {
        // Window glass
        baseColor = vec4(0.15, 0.45, 0.75, 1.0);
    }

    imageStore(uFacadeTexture, coord, baseColor);
}
