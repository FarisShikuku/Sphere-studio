#version 450 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba8) uniform writeonly image2D outNormalImage;
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= 1024 || c.y >= 1024) return;
    vec2 uv = (vec2(c) + 0.5) / 1024.0;
    float weld = sin(uv.x * 31.4159) * 0.08;
    vec3 n = normalize(vec3(weld, 0.0, 1.0));
    imageStore(outNormalImage, c, vec4(n * 0.5 + 0.5, 1.0));
}
