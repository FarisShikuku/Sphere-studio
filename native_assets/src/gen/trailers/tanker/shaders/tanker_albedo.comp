#version 450 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba8) uniform writeonly image2D outAlbedoImage;
layout(push_constant) uniform PushConstants { vec4 shellColor; vec4 stripeColor; float wear; } pc;
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= 1024 || c.y >= 1024) return;
    vec2 uv = (vec2(c) + 0.5) / 1024.0;
    float band = step(0.46, uv.y) * (1.0 - step(0.54, uv.y));
    vec3 col = mix(pc.shellColor.rgb, pc.stripeColor.rgb, band);
    imageStore(outAlbedoImage, c, vec4(col, 1.0));
}
