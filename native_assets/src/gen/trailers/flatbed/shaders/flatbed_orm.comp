#version 450 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba8) uniform writeonly image2D outOrmImage;
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= 1024 || c.y >= 1024) return;
    vec2 uv = (vec2(c) + 0.5) / 1024.0;
    float isSteel = 1.0 - step(0.08, uv.y) * (1.0 - step(0.92, uv.y));
    imageStore(outOrmImage, c, vec4(0.9, mix(0.74, 0.36, isSteel), mix(0.02, 0.85, isSteel), 1.0));
}
