#version 450 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D outAlbedoImage;

layout(push_constant) uniform PushConstants {
    uint regionMask; // 0=tire rubber, 1=silver rim, 2=red caliper, 3=chassis black
    float wear;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= 1024 || coord.y >= 1024) return;
    vec2 uv = (vec2(coord) + 0.5) / 1024.0;

    vec3 tireCol = vec3(0.08, 0.085, 0.09);
    vec3 rimCol = vec3(0.78, 0.80, 0.84);
    vec3 caliperCol = vec3(0.76, 0.14, 0.12);
    vec3 col = (uv.y < 0.5) ? tireCol : mix(rimCol, caliperCol, step(0.82, uv.x));
    col = mix(col, vec3(0.24, 0.21, 0.18), pc.wear * 0.35);
    imageStore(outAlbedoImage, coord, vec4(col, 1.0));
}
