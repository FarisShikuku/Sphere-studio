#version 450 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba8) uniform writeonly image2D outOrmImage;
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= 1024 || c.y >= 1024) return;
    vec2 uv = (vec2(c) + 0.5) / 1024.0;
    float isBuckle = step(uv.y, 0.08) * (1.0 - smoothstep(0.02, 0.05, abs(fract(uv.x * 12.0) - 0.5)));
    imageStore(outOrmImage, c, vec4(0.92, mix(0.62, 0.24, isBuckle), mix(0.04, 0.90, isBuckle), 1.0));
}
