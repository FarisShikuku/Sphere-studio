#version 450 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba8) uniform writeonly image2D outAlbedoImage;
layout(push_constant) uniform PushConstants { vec4 pvcColor; vec4 logoColor; float opacityBias; float dirt; } pc;
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= 1024 || c.y >= 1024) return;
    vec2 uv = (vec2(c) + 0.5) / 1024.0;
    float stripe = step(0.42, uv.y) * (1.0 - step(0.58, uv.y));
    float strap = 1.0 - smoothstep(0.02, 0.045, abs(fract(uv.x * 12.0) - 0.5));
    vec3 col = mix(pc.pvcColor.rgb, pc.logoColor.rgb, stripe * 0.85);
    col = mix(col, vec3(0.18), strap * 0.65);
    col = mix(col, vec3(0.28, 0.24, 0.19), pc.dirt * (1.0 - smoothstep(0.0, 0.35, uv.y)));
    imageStore(outAlbedoImage, c, vec4(col, pc.opacityBias));
}
