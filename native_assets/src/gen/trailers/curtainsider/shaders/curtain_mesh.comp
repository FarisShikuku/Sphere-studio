#version 450 core
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
struct Vertex { vec4 position; vec4 normal; vec4 uv_tangent; };
layout(std430, binding = 0) buffer OutVertexBuffer { Vertex vertices[]; };
layout(push_constant) uniform PushConstants { vec4 dims; float billowAmp; float time; } pc;
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= 2048u) return;
    float u = float(idx % 64u) / 63.0;
    float v = float(idx / 64u) / 31.0;
    float pinch = smoothstep(0.0, 0.14, abs(fract(u * 12.0) - 0.5));
    float dz = pc.billowAmp * pinch * sin(v * 3.14159265) * sin(u * 37.699 + pc.time);
    vec3 p = vec3((u - 0.5) * pc.dims.x, 1.25 + v * (pc.dims.z - 1.25), pc.dims.y * 0.5 + dz);
    vertices[idx].position = vec4(p, 1.0);
    vertices[idx].normal = vec4(0.0, 0.0, 1.0, 0.0);
    vertices[idx].uv_tangent = vec4(u, v, 1.0, 0.0);
}
