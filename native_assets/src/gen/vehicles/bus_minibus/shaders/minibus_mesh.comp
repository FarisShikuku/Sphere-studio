#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/minibus_common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer MinibusVerts { vec4 v[]; };
layout(push_constant) uniform Push { MinibusPushConstants pc; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 64u) return;
    v[i] = vec4(-2.69 + float(i) * 0.085, 2.34, 0.94, 1.0);
}
