#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/rigid_lorry_common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer BodyVertices { vec4 v[]; };
layout(push_constant) uniform Push { RigidLorryPushConstants pc; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 64u) return;
    v[i] = vec4(float(i) * 0.08, 1.2 + pc.actionRatio * 1.5, 0.0, 1.0);
}
