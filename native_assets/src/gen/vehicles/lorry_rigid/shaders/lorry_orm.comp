#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/rigid_lorry_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, binding = 0) writeonly uniform image2D outOrm;
void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    imageStore(outOrm, gid, vec4(1.0, 0.36, 0.38, 1.0));
}
