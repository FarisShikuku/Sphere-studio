#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/rigid_lorry_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rg8, binding = 0) writeonly uniform image2D outNormal;
void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(gid) / vec2(imageSize(outNormal));
    float cor = sin(uv.x * 180.0) * 0.08 + 0.5;
    imageStore(outNormal, gid, vec4(cor, 0.5, 0.0, 1.0));
}
