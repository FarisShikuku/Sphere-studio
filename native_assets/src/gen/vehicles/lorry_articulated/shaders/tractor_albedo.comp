#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/tractor_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, binding = 0) writeonly uniform image2D outAlbedo;
layout(push_constant) uniform Push { TractorPushConstants pc; };
void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(gid) / vec2(imageSize(outAlbedo));
    float stripe = step(0.42, uv.y) * (1.0 - step(0.50, uv.y));
    imageStore(outAlbedo, gid, vec4(mix(pc.cabColor.rgb, pc.accentColor.rgb, stripe), 1.0));
}
