#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/tractor_common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer TractorVerts { vec4 v[]; };
layout(push_constant) uniform Push { TractorPushConstants pc; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 64u) return;
    v[i] = vec4(mix(-3.5, pc.fifthWheelOffset, float(i) / 63.0), 1.22, 0.0, 1.0);
}
