#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/cab_parts_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba8, binding = 0) writeonly uniform image2D outAlbedo;

layout(push_constant) uniform Push {
    CabPartPushConstants pc;
};

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(gid) / vec2(imageSize(outAlbedo));
    float flake = hash12(uv * 256.0 + float(pc.seed)) * 0.04;
    vec3 col = clamp(pc.paintColor.rgb + flake, 0.0, 1.0);
    imageStore(outAlbedo, gid, vec4(col, 1.0));
}
