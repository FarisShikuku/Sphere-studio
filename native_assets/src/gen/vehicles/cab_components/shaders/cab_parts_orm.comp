#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/cab_parts_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba8, binding = 0) writeonly uniform image2D outOrm;

layout(push_constant) uniform Push {
    CabPartPushConstants pc;
};

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    imageStore(outOrm, gid, vec4(1.0, pc.roughness, pc.metallic, 1.0));
}
