#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/cab_parts_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rg8, binding = 0) writeonly uniform image2D outNormal;

layout(push_constant) uniform Push {
    CabPartPushConstants pc;
};

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(gid) / vec2(imageSize(outNormal));
    float seam = step(0.985, max(uv.x, uv.y));
    vec2 n = mix(vec2(0.5, 0.5), vec2(0.35, 0.5), seam);
    imageStore(outNormal, gid, vec4(n, 0.0, 1.0));
}
