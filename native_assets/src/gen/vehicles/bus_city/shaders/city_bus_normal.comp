#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/city_bus_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rg8, binding = 0) writeonly uniform image2D outNormal;
void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    imageStore(outNormal, gid, vec4(0.5, 0.5, 0.0, 1.0));
}
