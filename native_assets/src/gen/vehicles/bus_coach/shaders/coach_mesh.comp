#version 460
#extension GL_GOOGLE_include_directive : enable
#include "include/coach_common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer CoachVerts { vec4 v[]; };
layout(push_constant) uniform Push { CoachPushConstants pc; };
void main() {
