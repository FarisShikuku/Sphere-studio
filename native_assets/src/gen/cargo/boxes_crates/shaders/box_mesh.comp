#version 450
layout(local_size_x = 36) in;

struct Vertex {
    vec3 position;
    vec3 normal;
    vec4 tangent;
    vec2 uv;
    vec4 color;
};

layout(std430, binding = 0) buffer OutputBoxMesh {
    Vertex vertices[];
};

layout(push_constant) uniform BoxGeomParams {
    vec3 dimensions;
    vec4 baseColor;
} uGeom;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= 36u) return; // 6 faces * 6 vertices per cube

    vec3 h = uGeom.dimensions * 0.5;
    uint face = idx / 6u;
    uint vertInFace = idx % 6u;

    vec3 normal = vec3(0.0);
    vec3 p0 = vec3(0.0);
    vec3 p1 = vec3(0.0);
    vec3 p2 = vec3(0.0);
    vec3 p3 = vec3(0.0);

    if (face == 0u) { normal = vec3(0, 0, 1); p0 = vec3(-h.x, -h.z, h.y); p1 = vec3(h.x, -h.z, h.y); p2 = vec3(h.x, h.z, h.y); p3 = vec3(-h.x, h.z, h.y); }
    else if (face == 1u) { normal = vec3(0, 0, -1); p0 = vec3(h.x, -h.z, -h.y); p1 = vec3(-h.x, -h.z, -h.y); p2 = vec3(-h.x, h.z, -h.y); p3 = vec3(h.x, h.z, -h.y); }
    else if (face == 2u) { normal = vec3(0, 1, 0); p0 = vec3(-h.x, h.z, h.y); p1 = vec3(h.x, h.z, h.y); p2 = vec3(h.x, h.z, -h.y); p3 = vec3(-h.x, h.z, -h.y); }
    else if (face == 3u) { normal = vec3(0, -1, 0); p0 = vec3(-h.x, -h.z, -h.y); p1 = vec3(h.x, -h.z, -h.y); p2 = vec3(h.x, -h.z, h.y); p3 = vec3(-h.x, -h.z, h.y); }
    else if (face == 4u) { normal = vec3(1, 0, 0); p0 = vec3(h.x, -h.z, h.y); p1 = vec3(h.x, -h.z, -h.y); p2 = vec3(h.x, h.z, -h.y); p3 = vec3(h.x, h.z, h.y); }
    else { normal = vec3(-1, 0, 0); p0 = vec3(-h.x, -h.z, -h.y); p1 = vec3(-h.x, -h.z, h.y); p2 = vec3(-h.x, h.z, h.y); p3 = vec3(-h.x, h.z, -h.y); }

    vec3 pos = vec3(0.0);
    vec2 uv = vec2(0.0);
    if (vertInFace == 0u) { pos = p0; uv = vec2(0, 0); }
    else if (vertInFace == 1u) { pos = p1; uv = vec2(1, 0); }
    else if (vertInFace == 2u) { pos = p2; uv = vec2(1, 1); }
    else if (vertInFace == 3u) { pos = p0; uv = vec2(0, 0); }
    else if (vertInFace == 4u) { pos = p2; uv = vec2(1, 1); }
    else { pos = p3; uv = vec2(0, 1); }

    Vertex v;
    v.position = pos;
    v.normal = normal;
    v.tangent = vec4(1, 0, 0, 1);
    v.uv = uv;
    v.color = uGeom.baseColor;

    vertices[idx] = v;
}
