#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/boxes_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outORM;

layout(push_constant) uniform BoxOrmParams {
    float roughness;
    float metallic;
    uint constructionType;
} uOrm;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outORM);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);

    float ao = 1.0;
    float rough = uOrm.roughness;
    float metal = uOrm.metallic;

    if (uOrm.constructionType == 1u || uOrm.constructionType == 3u) {
        // Slat crease ambient occlusion
        float slat = fract(uv.y * 6.0);
        if (slat < 0.05) ao = 0.3;
        rough += (BoxNoise(uv * 32.0) - 0.5) * 0.15;
    }

    imageStore(outORM, pixelCoord, vec4(ao, clamp(rough, 0.04, 0.98), metal, 1.0));
}
