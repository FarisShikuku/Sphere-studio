#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/bagged_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outAlbedo;

layout(push_constant) uniform BagParams {
    vec4 baseColor;
    vec4 labelColor;
    float weaveFrequency;
    float wearFactor;
    uint seed;
} uParams;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outAlbedo);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);

    // Fabric weave micro-shading
    float weave = WovenFabricWeave(uv, uParams.weaveFrequency > 0.0 ? uParams.weaveFrequency : 180.0);
    vec3 fabricCol = uParams.baseColor.rgb * (0.92 + 0.16 * weave);

    // Stencil / Branding area in center
    vec2 centerDist = abs(uv - vec2(0.5, 0.4));
    float stencilMask = 0.0;
    if (centerDist.x < 0.32 && centerDist.y < 0.18) {
        float textPattern = BagNoise(uv * 48.0);
        stencilMask = smoothstep(0.42, 0.52, textPattern);
    }

    vec3 finalColor = mix(fabricCol, uParams.labelColor.rgb, stencilMask * uParams.labelColor.a);

    // Dust & dirt wear
    float dirt = BagFbmFolds(uv * 12.0 + vec2(float(uParams.seed % 100u)), 3);
    finalColor = mix(finalColor, vec3(0.55, 0.48, 0.38), dirt * uParams.wearFactor * 0.45);

    imageStore(outAlbedo, pixelCoord, vec4(finalColor, 1.0));
}
