#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/bagged_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outORM;

layout(push_constant) uniform OrmParams {
    float baseRoughness;
    float metallic;
    float occlusionScale;
} uOrm;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outORM);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);

    // Occlusion: creases hold ambient shadow
    float folds = BagFbmFolds(uv * 18.0, 4);
    float ao = clamp(1.0 - (1.0 - folds) * uOrm.occlusionScale * 0.4, 0.2, 1.0);

    // Roughness: fabric weave has micro variations
    float roughness = clamp(uOrm.baseRoughness + (BagNoise(uv * 96.0) - 0.5) * 0.12, 0.05, 0.98);

    // Metallic: Bags are dielectrics (0.0), foil sacks may have subtle metallic specular
    float metallic = uOrm.metallic;

    imageStore(outORM, pixelCoord, vec4(ao, roughness, metallic, 1.0));
}
