#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/bagged_common.glsl"

layout(binding = 0, rg8) uniform writeonly image2D outNormal;

layout(push_constant) uniform NormalParams {
    float wrinkleDepth;
    float weaveDepth;
    uint seed;
} uNorm;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outNormal);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);
    vec2 eps = vec2(1.0) / vec2(imgSize);

    // Height calculation from folds and weave
    float hC = BagFbmFolds(uv * 18.0, 4) * uNorm.wrinkleDepth + WovenFabricWeave(uv, 180.0) * uNorm.weaveDepth;
    float hR = BagFbmFolds((uv + vec2(eps.x, 0.0)) * 18.0, 4) * uNorm.wrinkleDepth + WovenFabricWeave(uv + vec2(eps.x, 0.0), 180.0) * uNorm.weaveDepth;
    float hU = BagFbmFolds((uv + vec2(0.0, eps.y)) * 18.0, 4) * uNorm.wrinkleDepth + WovenFabricWeave(uv + vec2(0.0, eps.y), 180.0) * uNorm.weaveDepth;

    vec3 n = normalize(vec3((hC - hR) / eps.x, (hC - hU) / eps.y, 1.0));
    vec2 bc5Normal = n.xy * 0.5 + 0.5;

    imageStore(outNormal, pixelCoord, vec4(bc5Normal, 0.0, 1.0));
}
