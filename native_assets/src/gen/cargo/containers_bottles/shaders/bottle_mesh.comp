#version 450
layout(local_size_x = 64) in;

struct Vertex {
    vec3 position;
    vec3 normal;
    vec4 tangent;
    vec2 uv;
    vec4 color;
};

layout(std430, binding = 0) buffer OutputBottleMesh {
    Vertex vertices[];
};

layout(push_constant) uniform BottleMeshParams {
    float baseRadius;
    float totalHeight;
    uint radialSegs;
    uint profileSegs;
    uint totalVertices;
} uGeom;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uGeom.totalVertices) return;

    uint ir = idx % (uGeom.radialSegs + 1u);
    uint ip = idx / (uGeom.radialSegs + 1u);

    float u = float(ir) / float(uGeom.radialSegs);
    float v = float(ip) / float(uGeom.profileSegs);

    float angle = u * 6.2831853;
    float y = v * uGeom.totalHeight;

    // Lathe profile radius
    float r = uGeom.baseRadius;
    if (v < 0.05) {
        r *= (0.88 + 0.12 * (v / 0.05));
    } else if (v > 0.60 && v < 0.82) {
        float st = (v - 0.60) / 0.22;
        r *= (1.0 - st * 0.65);
    } else if (v >= 0.82 && v < 0.96) {
        r *= 0.35;
    } else if (v >= 0.96) {
        r *= 0.40;
    }

    vec3 pos = vec3(cos(angle) * r, y, sin(angle) * r);
    vec3 norm = normalize(vec3(cos(angle), 0.1, sin(angle)));

    Vertex vert;
    vert.position = pos;
    vert.normal = norm;
    vert.tangent = vec4(-sin(angle), 0.0, cos(angle), 1.0);
    vert.uv = vec2(u, v);
    vert.color = vec4(1.0);

    vertices[idx] = vert;
}
