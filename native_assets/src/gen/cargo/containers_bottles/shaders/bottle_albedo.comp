#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/bottle_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outAlbedo;

layout(push_constant) uniform BottleAlbedoParams {
    vec4 liquidColor;
    vec4 labelColor;
    uint substrateType;
    uint seed;
} uBottle;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outAlbedo);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);
    vec3 col = uBottle.liquidColor.rgb;

    // Body label wrap (v from 0.15 to 0.55)
    if (uv.y > 0.15 && uv.y < 0.55) {
        // Label paper substrate
        col = mix(col, uBottle.labelColor.rgb, 0.95);
        // Stencil branding crest
        if (abs(uv.x - 0.5) < 0.18 && abs(uv.y - 0.35) < 0.12) {
            float crest = BottleNoise(uv * 32.0);
            col = mix(col, vec3(0.95, 0.85, 0.25), step(0.48, crest)); // Gold foil medal
        }
    }

    // Crown cap / screw cap area at top (v > 0.94)
    if (uv.y > 0.94) {
        col = vec3(0.85, 0.85, 0.90); // Metallic crown cap
    }

    imageStore(outAlbedo, pixelCoord, vec4(col, uBottle.liquidColor.a));
}
