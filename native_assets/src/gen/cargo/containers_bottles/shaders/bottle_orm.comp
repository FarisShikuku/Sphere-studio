#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/bottle_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outORM;

layout(push_constant) uniform BottleOrmParams {
    float glassRoughness;
    float opacityBias;
} uOrm;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outORM);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);

    float ao = 1.0;
    float rough = uOrm.glassRoughness;
    float metal = 0.0;

    // Label area (rough paper)
    if (uv.y > 0.15 && uv.y < 0.55) {
        rough = 0.68;
    }

    // Crown metal cap
    if (uv.y > 0.94) {
        rough = 0.22;
        metal = 0.95;
    }

    imageStore(outORM, pixelCoord, vec4(ao, rough, metal, uOrm.opacityBias));
}
