#version 450 core
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Vertex {
    vec4 position;
    vec4 normal;
    vec4 uv_tangent;
};

layout(std430, binding = 0) buffer OutVertexBuffer {
    Vertex vertices[];
};

layout(push_constant) uniform PushConstants {
    vec4 halfExtents;
    uint materialForm;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= 4096u) return;
    float u = float(idx % 64u) / 63.0;
    float v = float(idx / 64u) / 63.0;
    vec3 p = vec3((u - 0.5) * 2.0 * pc.halfExtents.x, 0.0, (v - 0.5) * 2.0 * pc.halfExtents.z);
    if (pc.materialForm == 8u) {
        p.y = 0.025 * sin(v * 50.26548);
    }
    vertices[idx].position = vec4(p, 1.0);
    vertices[idx].normal = vec4(0.0, 1.0, 0.0, 0.0);
    vertices[idx].uv_tangent = vec4(u, v, 1.0, 0.0);
}
