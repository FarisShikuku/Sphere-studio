#version 450 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D outAlbedoImage;

layout(push_constant) uniform PushConstants {
    vec4 baseColor;
    vec4 accentColor;
    uint materialForm;
    float weathering;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= 1024 || coord.y >= 1024) return;
    vec2 uv = (vec2(coord) + 0.5) / 1024.0;

    float grain = fract(sin(dot(uv * 256.0, vec2(12.9898, 78.233))) * 43758.5453);
    vec3 col = pc.baseColor.rgb * mix(0.88, 1.08, grain);
    if (pc.materialForm == 2u) {
        col = mix(col, pc.accentColor.rgb, 0.25 * sin(uv.x * 48.0) * cos(uv.y * 48.0));
    }
    imageStore(outAlbedoImage, coord, vec4(col, pc.baseColor.a));
}
