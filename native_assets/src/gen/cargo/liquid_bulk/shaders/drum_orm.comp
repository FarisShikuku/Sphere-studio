#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/liquid_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outORM;

layout(push_constant) uniform DrumOrmParams {
    float roughness;
    float metallic;
} uOrm;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outORM);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);

    // Chime rust increases roughness and lowers metalness
    float rust = RustFlaking(uv);
    float rough = mix(uOrm.roughness, 0.88, rust);
    float metal = mix(uOrm.metallic, 0.05, rust);
    float ao = mix(1.0, 0.55, rust);

    imageStore(outORM, pixelCoord, vec4(ao, rough, metal, 1.0));
}
