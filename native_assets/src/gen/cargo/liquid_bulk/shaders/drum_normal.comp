#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/liquid_common.glsl"

layout(binding = 0, rg8) uniform writeonly image2D outNormal;

layout(push_constant) uniform DrumNormParams {
    float ribHeight;
    float dentDepth;
} uNorm;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outNormal);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);
    vec2 eps = vec2(1.0) / vec2(imgSize);

    // Rolling hoop circumferential rib profile
    float rib1 = exp(-pow((uv.y - 0.35) * 40.0, 2.0));
    float rib2 = exp(-pow((uv.y - 0.65) * 40.0, 2.0));
    float hC = (rib1 + rib2) * uNorm.ribHeight + LiquidNoise(uv * 32.0) * uNorm.dentDepth;

    float r1_R = exp(-pow((uv.y - 0.35) * 40.0, 2.0));
    float r2_R = exp(-pow((uv.y - 0.65) * 40.0, 2.0));
    float hR = (r1_R + r2_R) * uNorm.ribHeight + LiquidNoise((uv + vec2(eps.x, 0.0)) * 32.0) * uNorm.dentDepth;

    float r1_U = exp(-pow(((uv.y + eps.y) - 0.35) * 40.0, 2.0));
    float r2_U = exp(-pow(((uv.y + eps.y) - 0.65) * 40.0, 2.0));
    float hU = (r1_U + r2_U) * uNorm.ribHeight + LiquidNoise((uv + vec2(0.0, eps.y)) * 32.0) * uNorm.dentDepth;

    vec3 n = normalize(vec3((hC - hR) / eps.x, (hC - hU) / eps.y, 1.0));
    imageStore(outNormal, pixelCoord, vec4(n.xy * 0.5 + 0.5, 0.0, 1.0));
}
