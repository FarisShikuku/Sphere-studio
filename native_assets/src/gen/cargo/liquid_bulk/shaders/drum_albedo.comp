#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/liquid_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outAlbedo;

layout(push_constant) uniform DrumAlbedoParams {
    vec4 baseColor;
    vec4 decalColor;
    float rustFactor;
    uint seed;
} uDrum;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outAlbedo);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);
    vec3 col = uDrum.baseColor.rgb;

    // Chipped paint along chime edges
    float rustMask = RustFlaking(uv) * uDrum.rustFactor;
    vec3 rustCol = vec3(0.42, 0.22, 0.12); // Iron oxide rust
    col = mix(col, rustCol, rustMask);

    // Hazard diamond placard in center
    vec2 centerDist = abs(uv - vec2(0.5, 0.5));
    if ((centerDist.x + centerDist.y) < 0.16) {
        col = uDrum.decalColor.rgb;
    }

    imageStore(outAlbedo, pixelCoord, vec4(col, 1.0));
}
