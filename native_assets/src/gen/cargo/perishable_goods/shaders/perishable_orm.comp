#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#include "include/perishable_common.glsl"

layout(binding = 0, rgba8) uniform writeonly image2D outORM;

layout(push_constant) uniform PerishOrmParams {
    float roughness;
    float wetness;
} uOrm;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outORM);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    vec2 uv = vec2(pixelCoord) / vec2(imgSize);

    // Wetness lowers roughness for glistening fresh fruit / iced fish
    float rough = mix(uOrm.roughness, 0.08, uOrm.wetness);
    float ao = 1.0;
    float metal = 0.0;

    imageStore(outORM, pixelCoord, vec4(ao, rough, metal, 1.0));
}
