#version 460
// Vulkan 1.3 Compute Shader: Parallel Bitonic Merge Sort for Spatial Cell Keys
// Ported from talvinckb/OpenGL-Water-Simulation

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct SpatialEntry {
    uint particleIndex;
    uint hash;
    uint cellKey;
    uint pad;
};

layout(std430, set = 0, binding = 4) buffer SpatialIndicesBuffer {
    SpatialEntry entries[];
};

layout(push_constant) uniform SortPush {
    uint numEntries;
    uint groupWidth;
    uint groupHeight;
    uint stepIndex;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint hIndex = i & (pc.groupWidth - 1u);
    uint indexLeft = hIndex + (pc.groupHeight + 1u) * (i / pc.groupWidth);
    uint rightStepSize = (pc.stepIndex == 0u) ? (pc.groupHeight - 2u * hIndex) : ((pc.groupHeight + 1u) / 2u);
    uint indexRight = indexLeft + rightStepSize;

    if (indexRight >= pc.numEntries) return;

    uint keyLeft = entries[indexLeft].cellKey;
    uint keyRight = entries[indexRight].cellKey;

    if (keyLeft > keyRight) {
        SpatialEntry temp = entries[indexLeft];
        entries[indexLeft] = entries[indexRight];
        entries[indexRight] = temp;
    }
}
