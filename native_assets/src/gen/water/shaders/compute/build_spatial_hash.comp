#version 460
// Vulkan 1.3 Compute Shader: 3D Spatial Hash Builder
// Ported from talvinckb/OpenGL-Water-Simulation

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct SpatialEntry {
    uint particleIndex;
    uint hash;
    uint cellKey;
    uint pad;
};

layout(std430, set = 0, binding = 1) readonly buffer PredictedPositionsBuffer {
    vec4 predictedPositions[];
};

layout(std430, set = 0, binding = 4) writeonly buffer SpatialIndicesBuffer {
    SpatialEntry spatialIndices[];
};

layout(std430, set = 0, binding = 5) writeonly buffer SpatialOffsetsBuffer {
    uint spatialOffsets[];
};

layout(push_constant) uniform FluidPush {
    float smoothingRadius;
    uint particleCount;
    uint hashTableSize;
    float pad;
} pc;

const uint PRIME_1 = 15823u;
const uint PRIME_2 = 9737333u;
const uint PRIME_3 = 440817757u;

ivec3 GetGridCell(vec3 pos, float cellSize) {
    return ivec3(floor(pos / cellSize));
}

uint HashCell3D(ivec3 cell) {
    uint a = uint(cell.x) * PRIME_1;
    uint b = uint(cell.y) * PRIME_2;
    uint c = uint(cell.z) * PRIME_3;
    return a + b + c;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.particleCount) return;

    spatialOffsets[idx] = 0xFFFFFFFFu;

    vec3 pos = predictedPositions[idx].xyz;
    ivec3 cell = GetGridCell(pos, max(pc.smoothingRadius, 0.05));
    uint h = HashCell3D(cell);
    uint key = h % pc.hashTableSize;

    spatialIndices[idx].particleIndex = idx;
    spatialIndices[idx].hash = h;
    spatialIndices[idx].cellKey = key;
    spatialIndices[idx].pad = 0u;
}
