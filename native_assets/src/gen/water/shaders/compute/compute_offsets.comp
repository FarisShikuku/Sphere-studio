#version 460
// Vulkan 1.3 Compute Shader: Spatial Cell Start Offsets Lookup Table
// Ported from talvinckb/OpenGL-Water-Simulation

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct SpatialEntry {
    uint particleIndex;
    uint hash;
    uint cellKey;
    uint pad;
};

layout(std430, set = 0, binding = 4) readonly buffer SpatialIndicesBuffer {
    SpatialEntry entries[];
};

layout(std430, set = 0, binding = 5) writeonly buffer SpatialOffsetsBuffer {
    uint spatialOffsets[];
};

layout(push_constant) uniform OffsetPush {
    uint numEntries;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.numEntries) return;

    uint key = entries[idx].cellKey;
    uint prevKey = (idx == 0u) ? 0xFFFFFFFFu : entries[idx - 1u].cellKey;

    if (key != prevKey) {
        spatialOffsets[key] = idx;
    }
}
