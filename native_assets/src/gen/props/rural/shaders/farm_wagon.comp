#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform FarmWagonPush { float length; float width; float wheelRadius; } pc;
layout(std430, binding = 0) writeonly buffer WagonWheels { vec4 outWheels[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= 4u) return;
    float sx = (idx < 2u) ? -0.38 : 0.38;
    float sz = ((idx % 2u) == 0u) ? -0.5 : 0.5;
    outWheels[idx] = vec4(sx * pc.length, pc.wheelRadius, sz * pc.width, 1.0);
}
