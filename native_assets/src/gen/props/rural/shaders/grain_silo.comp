#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform GrainSiloPush { float height; float diameter; int tiers; } pc;
layout(std430, binding = 0) writeonly buffer SiloRings { vec4 outRings[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(max(1, pc.tiers))) return;
    float y = float(idx) * (pc.height / float(max(1, pc.tiers)));
    outRings[idx] = vec4(0.0, y, pc.diameter * 0.5, 1.0);
}
