#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PrivacyFencePush { float length; float height; int style; } pc;
layout(std430, binding = 0) writeonly buffer PrivacyFenceOut { vec4 outBoards[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint boards = uint(max(4, int(pc.height / 0.16)));
    if (idx >= boards) return;
    float y = (float(idx) + 0.5) * (pc.height / float(boards));
    outBoards[idx] = vec4(0.0, y, pc.length, 1.0);
}
