#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform BollardPush { float height; float radius; int style; } pc;
layout(std430, binding = 0) writeonly buffer BollardOut { vec4 outCaps[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx > 0u) return;
    outCaps[0] = vec4(0.0, pc.height, pc.radius, float(pc.style));
}
