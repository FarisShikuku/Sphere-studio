#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform CatenaryPushConstants {
    vec3 spanStart;
    vec3 spanEnd;
    float sag;
    float cableRadius;
    uint sampleCount;
} u_catenary;

struct PropVertex {
    vec4 position;
    vec4 normal;
    vec4 color;
};

layout(std430, binding = 0) buffer OutputVertexBuffer {
    PropVertex vertices[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_catenary.sampleCount) return;
    float t = float(idx) / float(u_catenary.sampleCount - 1);
    vec3 p = mix(u_catenary.spanStart, u_catenary.spanEnd, t);
    float catSag = 4.0 * u_catenary.sag * t * (1.0 - t);
    p.y -= catSag;
    vertices[idx].position = vec4(p, 1.0);
    vertices[idx].color = vec4(0.15, 0.15, 0.18, 1.0);
}
