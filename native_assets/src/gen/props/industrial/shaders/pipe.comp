#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PipePushConstants {
    float length;
    float radius;
    int pipeConfig;
    uint hasHandwheelValve;
} u_pipe;

struct PropVertex {
    vec4 position;
    vec4 normal;
    vec4 color;
};

layout(std430, binding = 0) buffer OutputVertexBuffer {
    PropVertex vertices[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
}
