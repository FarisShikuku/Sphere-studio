#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform CratePushConstants {
    float width;
    float height;
    float depth;
    uint hasCrossBraces;
    uint hasMetalCorners;
} u_crate;

struct PropVertex {
    vec4 position;
    vec4 normal;
    vec4 color;
};

layout(std430, binding = 0) buffer OutputVertexBuffer {
    PropVertex vertices[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
}
