#version 450
#include "include/gate_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform EstateGatePush { GatePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { GatePropVertex vertices[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx > 1u) return;
    float side = (idx == 0u) ? -1.0 : 1.0;
    vertices[idx].position = vec4(side * pc.params.width * 0.5, pc.params.height * 0.5, 0.0, 1.0);
    vertices[idx].normal = vec4(0.0, 0.0, 1.0, 0.0);
    vertices[idx].color = vec4(resolveGateMetalTint(pc.params.colorScheme), 1.0);
}
