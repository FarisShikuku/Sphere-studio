#version 450
#include "include/gate_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform GlassSpeedGatePush { GatePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { GatePropVertex vertices[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint lanes = (pc.params.style == 1 && pc.params.width >= 2.2) ? 2u : 1u;
    if (idx > lanes) return;
    float x = -pc.params.width * 0.5 + float(idx) * (pc.params.width / float(lanes));
    vertices[idx].position = vec4(x, 0.52, 0.0, 1.0);
    vertices[idx].normal = vec4(0.0, 1.0, 0.0, 0.0);
    vertices[idx].color = vec4(0.22, 0.74, 0.97, 0.85);
}
