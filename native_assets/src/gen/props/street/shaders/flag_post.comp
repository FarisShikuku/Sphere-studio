#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform FlagPostPush {
    float poleHeight;
    float flagLength;
    float windPhase;
} pc;

layout(std430, binding = 0) writeonly buffer FlagClothNodes {
    vec4 outClothVertices[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= 32u) return;
    float t = float(idx) / 31.0;
    float wave = sin(t * 6.28318 + pc.windPhase) * 0.12 * t;
    outClothVertices[idx] = vec4(t * pc.flagLength, pc.poleHeight * 0.9, wave, 1.0);
}
