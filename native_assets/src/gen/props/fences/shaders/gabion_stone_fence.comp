#version 450
#include "include/fence_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform GabionFencePush { FencePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { FencePropVertex vertices[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint bays = computeFenceBayCount(pc.params.length, pc.params.postSpacing);
    if (idx > bays) return;
    float x = -pc.params.length * 0.5 + (float(idx) / float(bays)) * pc.params.length;
    vertices[idx].position = vec4(x, pc.params.height * 0.5, 0.0, 1.0);
    vertices[idx].normal = vec4(0.0, 1.0, 0.0, 0.0);
    vertices[idx].color = vec4(0.42, 0.46, 0.52, 1.0);
}
