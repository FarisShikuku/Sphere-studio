#version 450
#include "include/fence_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform LivingWallFencePush { FencePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { FencePropVertex vertices[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint pods = computeFenceBayCount(pc.params.length, pc.params.postSpacing) * 4u;
    if (idx >= pods) return;
    float x = -pc.params.length * 0.45 + (float(idx) / float(pods)) * pc.params.length * 0.90;
    vertices[idx].position = vec4(x, pc.params.height * 0.55, 0.10, 1.0);
    vertices[idx].normal = vec4(0.0, 0.0, 1.0, 0.0);
    vertices[idx].color = vec4(0.13, 0.52, 0.24, 1.0);
}
