#version 450
#include "include/fence_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform CorrugatedCortenPush { FencePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { FencePropVertex vertices[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint ribs = uint(max(8, int(pc.params.length / 0.16)));
    if (idx >= ribs) return;
    float x = -pc.params.length * 0.5 + (float(idx) + 0.5) * (pc.params.length / float(ribs));
    float z = ((idx % 2u) == 0u) ? 0.024 : -0.024;
    vertices[idx].position = vec4(x, pc.params.height * 0.5, z, 1.0);
    vertices[idx].normal = vec4(0.0, 0.0, 1.0, 0.0);
    vertices[idx].color = vec4(0.60, 0.20, 0.07, 1.0);
}
