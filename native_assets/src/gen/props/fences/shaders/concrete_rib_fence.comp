#version 450
#include "include/fence_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform ConcreteRibFencePush { FencePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { FencePropVertex vertices[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint tiers = (pc.params.style == 1) ? 4u : 3u;
    if (idx >= tiers) return;
    float y = (float(idx) + 0.5) * (pc.params.height / float(tiers));
    vertices[idx].position = vec4(0.0, y, 0.0, 1.0);
    vertices[idx].normal = vec4(0.0, 0.0, 1.0, 0.0);
    vertices[idx].color = vec4(0.60, 0.64, 0.69, 1.0);
}
