#version 450
#include "include/fence_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform LouverBladeFencePush { FencePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { FencePropVertex vertices[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint blades = uint(max(5, int(pc.params.height / 0.11)));
    if (idx >= blades) return;
    float y = 0.12 + float(idx) * ((pc.params.height - 0.18) / float(max(1u, blades - 1u)));
    vertices[idx].position = vec4(0.0, y, 0.0, 1.0);
    vertices[idx].normal = normalize(vec4(0.0, 0.4, 0.9, 0.0));
    vertices[idx].color = vec4(resolveFenceMetalTint(pc.params.colorScheme), 1.0);
}
