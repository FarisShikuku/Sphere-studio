#version 450
#include "include/fence_common.glsl"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform CableRailFencePush { FencePushParams params; } pc;
layout(std430, binding = 0) buffer OutputVertexBuffer { FencePropVertex vertices[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint cables = uint(max(5, int((pc.params.height - 0.15) / 0.12)));
    if (idx >= cables) return;
    float y = 0.12 + float(idx) * ((pc.params.height - 0.22) / float(max(1u, cables - 1u)));
    vertices[idx].position = vec4(0.0, y, 0.0, 1.0);
    vertices[idx].normal = vec4(0.0, 1.0, 0.0, 0.0);
    vertices[idx].color = vec4(0.82, 0.86, 0.90, 1.0);
}
