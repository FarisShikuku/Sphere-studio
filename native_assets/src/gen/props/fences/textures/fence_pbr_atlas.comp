#version 450
#include "fence_material.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D uFencePbrAtlas;

layout(push_constant) uniform FenceAtlasPush {
    uint uMaterialMode;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uFencePbrAtlas);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    vec3 albedo = evalFenceSurfaceAlbedo(uv, pc.uMaterialMode);
    imageStore(uFencePbrAtlas, coord, vec4(albedo, 1.0));
}
