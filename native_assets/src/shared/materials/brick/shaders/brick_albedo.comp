#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outAlbedo;

#include "include/brick_common.glsl"

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(coord) / 2048.0;
    
    BrickCell cell = EvaluateBrickPattern(uv, vec2(215.0, 65.0), 10.0);
    
    vec3 baseClay = vec3(0.78, 0.36, 0.24);
    // Pseudorandom brick color shift
    float shift = sin(cell.brickIndex * 12.9898) * 0.08;
    vec3 brickColor = clamp(baseClay + vec3(shift, shift * 0.5, shift * -0.2), 0.0, 1.0);
    vec3 mortarColor = vec3(0.68, 0.67, 0.65);
    
    vec3 finalColor = mix(brickColor, mortarColor, cell.isMortar);
    imageStore(outAlbedo, coord, vec4(finalColor, 1.0));
}
